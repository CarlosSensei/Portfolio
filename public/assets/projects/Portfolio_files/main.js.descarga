(() => {
  (typeof ngDevMode === "undefined" || ngDevMode) && i05.\u0275setClassMetadata(Projects, [{
    type: Component5,
    args: [{ standalone: true, selector: "app-projects", imports: [], template: `<section class="projects-section"
[style.--accent]="activeProject.accentColor">

  <h2 class="title">
    Proyectos
  </h2>

  <div class="coverflow">

    @for (project of projects; track project.title; let i = $index) {

      <article
        class="project-card"
        [class.active]="i === activeIndex"
        [class.expanded]="expandedIndex === i"
        [style.transform]="getTransform(i)"
        [style.opacity]="getOpacity(i)"
        [style.z-index]="getZIndex(i)"
        (click)="setActive(i); toggleCard(i)">

        <img
          [src]="'assets/projects/' + project.image"
          [alt]="project.title">

        <div class="card-summary">

          <h3>{{ project.title }}</h3>

          <p>{{ project.shortDescription }}</p>

        </div>

        @if (expandedIndex === i) {

          <div class="card-details">

            <p class="description">{{ project.description }}</p>

            <div class="techs">

              @for (tech of project.technologies; track tech) {
                <span>{{ tech }}</span>
              }

            </div>

            @if (project.challenges.length > 0) {

              <div class="challenges">

                <h4>Retos t\xE9cnicos</h4>

                <ul>

                  @for (challenge of project.challenges; track challenge) {

                    <li>{{ challenge }}</li>
                  }

                </ul>

              </div>

            }
          </div>
          <div class="links">

            <a
              class="btn github"
              [href]="project.github"
              target="_blank"
              (click)="$event.stopPropagation()">
              GitHub
            </a>

            <a
              class="btn demo"
              [href]="project.demo"
              target="_blank"
              (click)="$event.stopPropagation()">
              Demo
            </a>

          </div>
        }
      </article>
    }
  </div>
</section>`, styles: ["/* src/features/projects/projects.css */\n.projects-section {\n  min-height: 100vh;\n  padding: 4rem 2rem;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  color: #fff;\n  transition: background 0.8s ease;\n}\n.title {\n  margin-bottom: 4rem;\n  text-align: center;\n  font-size: clamp(2.5rem, 5vw, 4rem);\n  font-weight: 700;\n  color: #fff;\n}\n.coverflow {\n  position: relative;\n  width: 100%;\n  height: 850px;\n  padding: 1rem;\n  display: flex;\n  justify-content: center;\n  align-items: flex-start;\n  perspective: 1800px;\n}\n.project-card {\n  position: absolute;\n  width: 600px;\n  height: 420px;\n  overflow: hidden;\n  border-radius: 24px;\n  cursor: pointer;\n  color: #fff;\n  background: rgba(255, 255, 255, 0.06);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  -webkit-backdrop-filter: blur(20px);\n  backdrop-filter: blur(20px);\n  transition: all 0.6s ease;\n  opacity: 0.4;\n}\n.project-card.active {\n  transform: translateX(0) rotateY(0) scale(1);\n  opacity: 1;\n  z-index: 10;\n  box-shadow:\n    0 0 15px rgba(0, 191, 255, 0.6),\n    0 0 30px rgba(0, 191, 255, 0.45),\n    0 0 60px rgba(0, 191, 255, 0.3),\n    0 0 100px rgba(0, 191, 255, 0.15);\n}\n.project-card.expanded {\n  width: 680px;\n  height: 830px;\n  opacity: 1;\n  z-index: 999;\n  transform: translateX(0) rotateY(0) scale(1.05);\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);\n}\n.project-card img {\n  width: 100%;\n  height: 250px;\n  object-fit: cover;\n}\n.card-summary {\n  padding: 1.2rem;\n}\n.card-summary h3 {\n  margin-bottom: 0.75rem;\n  font-size: 1.4rem;\n  font-weight: 600;\n  color: #fff;\n}\n.card-summary p {\n  color: rgba(255, 255, 255, 0.85);\n  line-height: 1.5;\n}\n.card-details {\n  max-height: 0;\n  opacity: 0;\n  overflow: hidden;\n  padding: 0 1.2rem;\n  transition: max-height 0.5s ease, opacity 0.5s ease;\n}\n.project-card.expanded {\n  border-color: rgba(249, 115, 22, 0.5);\n  box-shadow:\n    0 0 20px